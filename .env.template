# SpotFX Environment Variables — copy to .env and fill in values

# Spotify OAuth (required)
# Get these from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# Home Assistant (optional)
HOME_ASSISTANT_HOST=http://homeassistant.local
HOME_ASSISTANT_TOKEN=your_ha_long_lived_token_here

# Audio capture device (optional — also configurable in Settings UI)
# "default" uses system default; set to "pulse" for PulseAudio/PipeWire on Linux
AUDIO_INPUT_DEVICE=default

# App server (defaults are usually fine)
APP_HOST=0.0.0.0
APP_PORT=8000
