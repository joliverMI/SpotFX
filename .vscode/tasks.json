{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SpotFX: Restart",
      "type": "shell",
      "command": "systemctl --user restart spotfx",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Start",
      "type": "shell",
      "command": ".venv/bin/python main.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Re-detect Marks (Dopamine)",
      "type": "shell",
      "command": "curl -s -X POST \"http://localhost:8000/api/audio-shape/redetect?uri=spotify%3Atrack%3A7vFKcXQ39f74XNrZmXADIT\" | .venv/bin/python -m json.tool",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Install Dependencies",
      "type": "shell",
      "command": ".venv/bin/pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Install Dependencies",
      "type": "shell",
      "command": ".venv/bin/pip install torch --index-url https://download.pytorch.org/whl/cpu && .venv/bin/pip install matplotlib",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Export Training Data",
      "type": "shell",
      "command": ".venv/bin/python -m nn.export_training_data",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Visualize Song",
      "type": "shell",
      "command": ".venv/bin/python -m nn.visualize --list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Visualize Song 3",
      "type": "shell",
      "command": ".venv/bin/python -m nn.visualize --song 3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Train MLP",
      "type": "shell",
      "command": ".venv/bin/python -m nn.train --model mlp --epochs 50",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Evaluate Model",
      "type": "shell",
      "command": ".venv/bin/python -m nn.evaluate --model mlp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Train Transformer",
      "type": "shell",
      "command": ".venv/bin/python -m nn.train --model transformer --epochs 150 --lr 0.001 --batch-size 8 --chunk-size 128 --jitter 0.02",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Train Transformer (no aug)",
      "type": "shell",
      "command": ".venv/bin/python -m nn.train --model transformer --epochs 100 --lr 0.001 --no-chunking --jitter 0.0",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: List Latin Songs",
      "type": "shell",
      "command": ".venv/bin/python -m nn.list_songs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Evaluate Transformer",
      "type": "shell",
      "command": ".venv/bin/python -m nn.evaluate --model transformer",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Update Recapture Playlist",
      "type": "shell",
      "command": ".venv/bin/python -m scripts.recapture_playlist --mode needs_recapture",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "LedFX: Restart Service",
      "type": "shell",
      "command": "systemctl --user restart ledfx.service && systemctl --user is-active ledfx.service",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "manual smoke test",
      "detail": "Claude updates this task's command whenever it wants the user to run a test. Never creates a new task for tests — always overwrites this one.",
      "type": "shell",
      "command": ".venv/bin/python scripts/smoke_morph_step.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
