{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SpotFX: Restart",
      "type": "shell",
      "command": "systemctl --user restart spotfx",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Start",
      "type": "shell",
      "command": ".venv/bin/python main.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Re-detect Marks (Dopamine)",
      "type": "shell",
      "command": "curl -s -X POST \"http://localhost:8000/api/audio-shape/redetect?uri=spotify%3Atrack%3A7vFKcXQ39f74XNrZmXADIT\" | .venv/bin/python -m json.tool",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Install Dependencies",
      "type": "shell",
      "command": ".venv/bin/pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Install Dependencies",
      "type": "shell",
      "command": ".venv/bin/pip install torch --index-url https://download.pytorch.org/whl/cpu && .venv/bin/pip install matplotlib",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Export Training Data",
      "type": "shell",
      "command": ".venv/bin/python -m nn.export_training_data",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Visualize Song",
      "type": "shell",
      "command": ".venv/bin/python -m nn.visualize --list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Visualize Song 3",
      "type": "shell",
      "command": ".venv/bin/python -m nn.visualize --song 3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Train MLP",
      "type": "shell",
      "command": ".venv/bin/python -m nn.train --model mlp --epochs 50",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Evaluate Model",
      "type": "shell",
      "command": ".venv/bin/python -m nn.evaluate --model mlp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Train Transformer",
      "type": "shell",
      "command": ".venv/bin/python -m nn.train --model transformer --epochs 150 --lr 0.001 --batch-size 8 --chunk-size 128 --jitter 0.02",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Train Transformer (no aug)",
      "type": "shell",
      "command": ".venv/bin/python -m nn.train --model transformer --epochs 100 --lr 0.001 --no-chunking --jitter 0.0",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: List Latin Songs",
      "type": "shell",
      "command": ".venv/bin/python -m nn.list_songs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "NN: Evaluate Transformer",
      "type": "shell",
      "command": ".venv/bin/python -m nn.evaluate --model transformer",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SpotFX: Update Recapture Playlist",
      "type": "shell",
      "command": ".venv/bin/python -m scripts.recapture_playlist --mode needs_recapture",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "LedFX: Restart Service",
      "type": "shell",
      "command": "systemctl --user restart ledfx.service && systemctl --user is-active ledfx.service",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "manual smoke test",
      "detail": "Claude updates this task's command whenever it wants the user to run a test. Never creates a new task for tests \u2014 always overwrites this one. Currently: Debug page xcorr graphs \u2014 opens /static/debug.html. Play a song with a saved shape, then check: (1) timeline slider under the Audio Shape canvas \u2014 drag the start/end/center handles, both graphs zoom together and the button flips to Manual; (2) middle-mouse drag pans both graphs; (3) in Follow mode the window tracks the live (downward) capture overlay's leading edge, advancing ~1s steps and lagging the song; after xcorr locks and stops it falls back to the playhead within ~5s; (4) the Live\u2212Saved diff hovers near zero on a fixed \u00b11 scale when synced and shows sustained excursions when misaligned; (5) saved vs live density looks comparable (both 25ms bins).",
      "type": "shell",
      "command": "xdg-open http://localhost:8000/static/debug.html",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}