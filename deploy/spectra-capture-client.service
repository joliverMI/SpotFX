# THE CAPTURE CLIENT AS A BOOT SERVICE — the camera host's own unit.
#
# It exists to remove the last human ritual in a calibration: a laptop that
# must be awake, unlocked, and holding a session when the night starts. With
# this installed on a machine whose camera is already aimed at the room, the
# session is simply THERE — at boot, after a crash, after a power cut, and
# after the network came back.
#
# INSTALL IT WITH THE SCRIPT, NOT BY HAND:
#
#     scripts/install_capture_client.sh --url http://spectra:8000/spectra \
#         --pose-name "the north shelf"
#
# It refuses BY NAME at every missing prerequisite, is safe to run twice,
# and writes the two things this unit points at:
#
#   %h/.local/bin/spectra-capture-client       the launcher (paths live HERE)
#   %h/.config/spectra-capture/client.env      the configuration (one file)
#
# WHY A LAUNCHER RATHER THAN PATHS IN THIS FILE. systemd will not expand an
# environment variable into the EXECUTABLE of ExecStart, so a unit that knew
# where the checkout and the interpreter live would have to be rewritten per
# machine — and a unit that is rewritten per machine is a unit nobody can
# verify. This file ships verbatim to every host and `systemd-analyze
# verify` checks the exact bytes that get installed; the launcher carries
# the one thing that genuinely differs between machines.
#
# THIS UNIT ACQUIRES NO ROOM AUTHORITY, and that is a property of what it
# starts rather than a promise made here: the capture client is a CAMERA
# process. It opens a device, holds a WebSocket, and sends frames and lock
# read-backs. It never takes the lights, never asks for them, and cannot —
# `never-takes-his-room` is unchanged by this unit existing, and a queue
# arriving on a room SPECTRA does not hold still refuses by name.
#
# THIS IS A USER UNIT, and boot-start therefore needs LINGER
# (`loginctl enable-linger <user>`), or it starts only when that user logs
# in. The installer checks for it by name and says so. It is a user unit
# rather than a system one because the client needs a home directory and the
# login session's own group membership (`video`, inherited — see below), and
# because a system unit for a camera would be the only piece of this whole
# area that needs root.
#
# ── NO `SupplementaryGroups=` HERE. EVER. THIS IS A USER UNIT. ─────────────
#
# DO NOT ADD IT BACK, however helpful it looks next to `DeviceAllow=`. An
# UNPRIVILEGED service manager cannot change group credentials AT ALL: the
# `setgroups(2)` call itself returns EPERM, and MEMBERSHIP IS IRRELEVANT to
# that. A user who IS in `video` fails exactly as hard as one who is not.
#
# Proven live on the owner's laptop, 2026-09-02→03, AFTER correct membership
# and a reboot:
#
#     (true)[...]: spectra-capture-client.service: Changing group
#                  credentials failed: Operation not permitted
#     systemd[...]: ... Main process exited, code=exited, status=216/GROUP
#
# It is also UNNECESSARY here. A user service INHERITS every supplementary
# group the login session's `systemd --user` manager holds, so membership in
# `video` — checked by name in `scripts/install_capture_client.sh`, and read
# out of the running manager's own `/proc/<pid>/status` by `--doctor` — is
# the whole mechanism. The directive added nothing and cost a reboot.
#
# THE BOUNDARY, so this is a rule and not a scar: `SupplementaryGroups=` is
# legitimate ONLY under a ROOT manager that drops privileges — a SYSTEM unit
# may carry it, a USER unit must not. There is no system unit for the
# capture client today. If one is ever added, it gets its OWN file rather
# than a shared template with a conditional line, because a directive whose
# legality depends on which manager loads it is exactly the kind of thing
# that gets copied into the wrong half.

[Unit]
Description=SPECTRA unattended capture client (camera host)
Documentation=https://github.com/joliverMI/SpotFX/blob/master/docs/CAPTURE_CLIENT_HOST.md
# The client's OWN reconnect loop is the real answer to a network that is
# not up yet (backoff, and it holds an open camera while it waits), so this
# is ordering only and nothing here Requires= it: a capture machine whose
# network never comes up should still be a process that says why, not a
# unit that never started.
After=network-online.target
Wants=network-online.target
# Do NOT give up after a burst of restarts: a camera that is unplugged for
# an hour must find the session again when it is plugged back in, and a
# rate-limited unit would sit dead until a human ran systemctl. (This lives
# in [Unit], not [Service] — systemd's own verifier says so, which is why
# the shipped file is verified rather than believed.)
StartLimitIntervalSec=0

[Service]
Type=simple
# NO `-` PREFIX, DELIBERATELY. A missing configuration file must stop the
# unit and name itself in the journal, not start a client that then guesses
# where SPECTRA lives. This is the same refuse-by-name rule the client's own
# `ConfigError` follows one layer up.
EnvironmentFile=%h/.config/spectra-capture/client.env
ExecStart=%h/.local/bin/spectra-capture-client
# A CAMERA HOST THAT DIES MUST COME BACK. `always` rather than `on-failure`
# because the client exits 2 on a bad configuration and 1 on an incomplete
# queue, and neither of those is a reason to leave the room with no camera
# until somebody notices — the record says what happened
# (`capture_health.py`), and coming back is what makes the night possible.
Restart=always
RestartSec=5
# It talks to one server and reads one camera. Nothing here needs to write
# outside its own home, and a capture process that could would be a
# surprise nobody asked for.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# ...except the machine-readable outcome, when the configuration asks for
# one. SPECTRA_CAPTURE_JSON_OUT defaults into this directory
# (%t = XDG_RUNTIME_DIR), which is the one path this service may write.
RuntimeDirectory=spectra-capture
ReadWritePaths=%t/spectra-capture
# The camera itself, and nothing else under /dev. Note that this NARROWS
# what the service may touch; it grants nothing. Reaching the camera is
# group membership, inherited from the manager — see the header for why no
# `SupplementaryGroups=` line belongs in a user unit.
DeviceAllow=char-video4linux rw

[Install]
WantedBy=default.target
