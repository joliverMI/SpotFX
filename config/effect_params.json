    "Strips":  { "virtuals": ["strip-effect","radial-dummy"],              "effects": ["melt","power"] },
    "Singles": { "virtuals": ["single-color-effect"],                      "effects": ["power"] }
  },
  "morph": {
    "supported_effects": ["power", "melt", "radial", "equalizer2d", "keybeat2d", "blackhole", "orbits"],
    "aspect_labels": {
      "shape": "Shape",
      "effect": "Effect",
      "color": "Color",
      "bg_color": "BG Color",
      "reactivity": "Reactivity",
      "brightness": "Brightness",
      "blur": "Blur"
    }
  },
  "effects": {
