{
  "categories": {
    "Matrix":  { "virtuals": ["crystal-mapper"],                           "effects": ["radial","noise","concentric","equalizer2d","blender","keybeat2d","gifplayer","blackhole"] },
    "Strips":  { "virtuals": ["strip-effect","radial-dummy"],              "effects": ["melt","power"] },
    "Singles": { "virtuals": ["single-color-effect"],                      "effects": ["power"] }
  },
  "morph": {
    "supported_effects": ["power", "melt", "radial", "equalizer2d", "keybeat2d", "blackhole"],
    "aspect_labels": {
      "shape": "Shape",
      "effect": "Effect",
      "color": "Color",
      "bg_color": "BG Color",
      "reactivity": "Reactivity",
      "brightness": "Brightness",
      "blur": "Blur"
    }
  },
  "effects": {
    "power": {
      "params": {
        "background_brightness": { "label":"Background Brightness","type":"numeric","smooth":true, "min":0,"max":1, "aspect":"brightness", "aspect_scale":1.0 },
        "background_color":      { "label":"BG Color",             "type":"color",  "smooth":true,                  "aspect":"bg_color" },
        "background_mode":       { "label":"BG Mode",              "type":"enum",   "smooth":false, "options":["additive","overwrite"] },
        "sparks_color":          { "label":"Accent Color",         "type":"color",  "smooth":true,                  "aspect":"reactivity", "accent":true },
        "brightness":            { "label":"Effect Brightness",    "type":"numeric","smooth":true, "min":0,"max":1, "aspect":"brightness", "aspect_scale":1.0 },
        "blur":                  { "label":"Blur",                 "type":"numeric","smooth":true, "min":0,"max":10,"aspect":"blur",       "aspect_scale":1.0 },
        "bass_decay_rate":       { "label":"Reactivity",           "type":"numeric","smooth":true, "min":0,"max":1, "aspect":"reactivity", "aspect_scale":1.0 },
        "sparks_decay_rate":     { "label":"Sparks Decay Rate",    "type":"numeric","smooth":true, "min":0,"max":1, "aspect":"reactivity", "aspect_scale":0.6 },
        "flip":                  { "label":"Flip",                 "type":"toggle", "smooth":false,                 "aspect":"shape" },
        "gradient_roll":         { "label":"Gradient Roll",        "type":"numeric","smooth":false,"min":1,"max":10 },
        "gradient":              { "label":"Gradient",             "type":"gradient","smooth":true,                 "aspect":"color" }
      },
      "defaults": {
        "background_brightness": 0.3,
        "background_color":      "#000000",
        "sparks_color":          "#FFFFFF",
        "brightness":            0.8,
        "blur":                  1.0,
        "bass_decay_rate":       0.4,
        "sparks_decay_rate":     0.4,
        "flip":                  false,
        "gradient_roll":         1,
        "gradient":              "linear-gradient(90deg, #ff0000 0%, #00ff00 50%, #0000ff 100%)"
      }
    },
    "melt": {
      "params": {
        "background_color":{ "label":"BG Color",        "type":"color",  "smooth":true,                  "aspect":"bg_color" },
        "background_mode":{ "label":"BG Mode",          "type":"enum",   "smooth":false, "options":["additive","overwrite"] },
        "brightness":    { "label":"Effect Brightness", "type":"numeric","smooth":true, "min":0,"max":1, "aspect":"brightness", "aspect_scale":1.0 },
        "gradient_roll": { "label":"Gradient Roll",     "type":"numeric","smooth":false,"min":1,"max":10 },
        "flip":          { "label":"Flip",              "type":"toggle", "smooth":false,                 "aspect":"shape" },
        "blur":          { "label":"Blur",              "type":"numeric","smooth":true, "min":0,"max":10,"aspect":"blur",       "aspect_scale":1.0 },
        "speed":         { "label":"Speed",             "type":"numeric","smooth":true, "min":0,"max":1 },
        "reactivity":    { "label":"Reactivity",        "type":"numeric","smooth":true, "min":0,"max":1, "aspect":"reactivity", "aspect_scale":1.0 },
        "gradient":      { "label":"Gradient",          "type":"gradient","smooth":true,                 "aspect":"color" }
      },
      "defaults": {
        "background_color": "#000000",
        "brightness":    0.8,
        "gradient_roll": 1,
        "flip":          false,
        "blur":          1.0,
        "speed":         0.4,
        "reactivity":    0.5,
        "gradient":      "linear-gradient(90deg, #ff0000 0%, #00ff00 50%, #0000ff 100%)"
      }
    },
    "noise": {
      "params": {
        "gradient":   { "label":"Gradient",          "type":"gradient","smooth":true },
        "brightness": { "label":"Effect Brightness", "type":"numeric","smooth":true, "min":0,"max":1 },
        "multiplier": { "label":"Reactivity",        "type":"numeric","smooth":true, "min":0,"max":4 },
        "speed":      { "label":"Speed",             "type":"numeric","smooth":true, "min":0,"max":5 },
        "zoom":       { "label":"Zoom",              "type":"numeric","smooth":true, "min":0,"max":5 }
      }
    },
    "concentric": {
      "params": {
        "gradient":         { "label":"Gradient",          "type":"gradient","smooth":true },
        "brightness":       { "label":"Effect Brightness", "type":"numeric","smooth":true, "min":0,"max":1 },
        "power_multiplier": { "label":"Reactivity",        "type":"numeric","smooth":true, "min":0,"max":1 },
        "speed":            { "label":"Speed",             "type":"numeric","smooth":true, "min":0,"max":1 },
        "gradient_scale":   { "label":"Zoom",              "type":"numeric","smooth":true, "min":0,"max":5 },
        "invert":           { "label":"Flip",              "type":"toggle", "smooth":false },
        "idle_speed":       { "label":"Speed",             "type":"numeric","smooth":true, "min":0,"max":1 },
        "center_smoothing": { "label":"Blur",              "type":"numeric","smooth":true, "min":0,"max":5 }
      }
    },
    "equalizer2d": {
      "params": {
        "background_color":      { "label":"BG Color",             "type":"color",  "smooth":true,                  "aspect":"bg_color" },
        "background_mode":       { "label":"BG Mode",              "type":"enum",   "smooth":false, "options":["additive","overwrite"] },
        "background_brightness": { "label":"Background Brightness","type":"numeric","smooth":true, "min":0,"max":1, "aspect":"brightness", "aspect_scale":1.0 },
        "brightness":            { "label":"Effect Brightness",    "type":"numeric","smooth":true, "min":0,"max":1, "aspect":"brightness", "aspect_scale":1.0 },
        "peak_color":            { "label":"Accent Color",         "type":"color",  "smooth":true,                                          "accent":true },
        "gradient_roll":         { "label":"Gradient Roll",        "type":"numeric","smooth":false,"min":1,"max":10 },
        "ring":                  { "label":"Flip",                 "type":"toggle", "smooth":true,                  "aspect":"shape" },
        "spin_multiplier":       { "label":"Reactivity",           "type":"numeric","smooth":true, "min":0,"max":5, "aspect":"reactivity", "aspect_scale":1.0 },
        "spin":                  { "label":"Spin",                 "type":"toggle", "smooth":false }
      },
      "defaults": {
        "background_color":      "#000000",
        "background_brightness": 0.3,
        "brightness":            0.8,
        "peak_color":            "#FFFFFF",
        "gradient_roll":         1,
        "ring":                  false,
        "spin_multiplier":       1.0,
        "spin":                  false
      }
    },
    "radial": {
      "params": {
        "polygon":   { "label":"Polygon",  "type":"toggle",  "smooth":false,                                  "aspect":"shape" },
        "spin":      { "label":"Speed",    "type":"numeric", "smooth":false, "min":0,"max":1,
                       "aspect":"reactivity", "aspect_scale":1.0,
                       "magnitude_only":true, "note":"Reactivity drives the magnitude; spin_sign/Flip owns the sign (magnitude_only preserves it on write)" },
        "spin_sign": { "label":"Flip",     "type":"toggle",  "smooth":false,
                       "maps_to":"spin",   "sign_control":true,                                              "aspect":"shape",
                       "note":"On=positive spin, Off=negative spin, Toggle=negate sign" },
        "twist":     { "label":"Twist",    "type":"numeric", "smooth":true,  "min":0,"max":10, "flip_sign":true, "aspect":"shape" },
        "star":      { "label":"Star",     "type":"numeric", "smooth":true,  "min":-1,"max":1, "flip_sign":true, "aspect":"shape" },
        "edges":     { "label":"Edges",    "type":"integer", "smooth":false, "min":0,"max":8,                    "aspect":"shape" },
        "x_offset":     { "label":"X Offset",     "type":"numeric","smooth":true, "min":-1,"max":1, "flip_sign":true, "scale_offset":true, "aspect":"shape" },
        "y_offset":     { "label":"Y Offset",     "type":"numeric","smooth":true, "min":-1,"max":1, "flip_sign":true, "scale_offset":true, "aspect":"shape" },
        "offset_polar": { "label":"Polar Offset", "type":"polar",  "smooth":true, "maps_x":"x_offset","maps_y":"y_offset" },
        "move_xy":      { "label":"Move by XY",    "type":"move_xy",    "smooth":true },
        "move_polar":   { "label":"Move by Polar", "type":"move_polar", "smooth":true }
      },
      "defaults": {
        "polygon":        false,
        "spin":           0.2,
        "spin_sign":      true,
        "twist":          0.0,
        "star":           0.0,
        "edges":          6,
        "x_offset":       0.0,
        "y_offset":       0.0,
        "source_virtual": "radial-dummy"
      }
    },
    "blender": {},
    "keybeat2d": {
      "params": {
        "image_location":     { "label":"Dance GIF",   "type":"string",  "smooth":false, "options_source":"gif_assets", "resets_effect":true,
                                "note":"LedFX asset path (spotfx/dancer/*.gif). ALWAYS patch together with beat_frames" },
        "beat_frames":        { "label":"Beat Frames", "type":"string",  "smooth":false, "resets_effect":true,
                                "note":"Frame indices that land on beats; comes from the gifsmith manifest" },
        "tint":               { "label":"Dancer Color","type":"color",   "smooth":true,                   "aspect":"color" },
        "image_brightness":   { "label":"Effect Brightness", "type":"numeric","smooth":true, "min":0.1,"max":3.0, "aspect":"brightness", "aspect_scale":1.0 },
        "stretch_horizontal": { "label":"Dancer Width",  "type":"integer","smooth":true, "min":1,"max":200,  "aspect":"shape" },
        "stretch_vertical":   { "label":"Dancer Height", "type":"integer","smooth":true, "min":1,"max":200,  "aspect":"shape" },
        "center_horizontal":  { "label":"Dancer X",    "type":"integer", "smooth":true, "min":-95,"max":95, "scale_offset":true, "aspect":"shape" },
        "center_vertical":    { "label":"Dancer Y",    "type":"integer", "smooth":true, "min":-95,"max":95, "scale_offset":true, "aspect":"shape" },
        "half_beat":          { "label":"Half Beat",   "type":"toggle",  "smooth":false,                  "aspect":"reactivity" },
        "ping_pong":          { "label":"Ping Pong",   "type":"toggle",  "smooth":false,                  "aspect":"shape" },
        "flip_horizontal":    { "label":"Flip",        "type":"toggle",  "smooth":false,                  "aspect":"shape" },
        "force_fit":          { "label":"Force Fit",   "type":"toggle",  "smooth":false },
        "keep_aspect_ratio":  { "label":"Keep Aspect", "type":"toggle",  "smooth":false }
      },
      "defaults": {
        "image_location":     "spotfx/dancer/dancer_basic.gif",
        "beat_frames":        "0 3 6 9 12 15 18 21",
        "tint":               "#ffffff",
        "image_brightness":   1.0,
        "force_fit":          true,
        "keep_aspect_ratio":  false,
        "stretch_horizontal": 100,
        "stretch_vertical":   100,
        "center_horizontal":  0,
        "center_vertical":    0
      }
    },
    "blackhole": {
      "params": {
        "swirl":                 { "label":"Swirl",                 "type":"numeric","smooth":true,  "min":-6,"max":6,      "flip_sign":true, "aspect":"shape" },
        "reverse":               { "label":"Reverse Flow",          "type":"toggle", "smooth":false,                        "aspect":"shape" },
        "radius_scale":          { "label":"Field Radius",          "type":"numeric","smooth":true,  "min":0.2,"max":2.0,   "aspect":"shape" },
        "blob_size":             { "label":"Blob Size",             "type":"numeric","smooth":true,  "min":0.5,"max":6,     "aspect":"shape" },
        "gradient_spin":         { "label":"Gradient Spin",         "type":"numeric","smooth":true,  "min":-1,"max":1,      "flip_sign":true, "aspect":"shape" },
        "trail_decay":           { "label":"Trail Length",          "type":"numeric","smooth":true,  "min":0,"max":1,       "aspect":"shape" },
        "horizon_scale":         { "label":"Horizon Size",          "type":"numeric","smooth":true,  "min":0,"max":0.8,     "aspect":"shape" },
        "horizon_audio":         { "label":"Horizon Audio",         "type":"numeric","smooth":true,  "min":-1,"max":1,      "aspect":"reactivity", "aspect_scale":0.4 },
        "horizon_color":         { "label":"Accent Color",          "type":"color",  "smooth":true,                         "aspect":"reactivity", "accent":true },
        "base_speed":            { "label":"Infall Speed",          "type":"numeric","smooth":true,  "min":0.05,"max":2.0,  "aspect":"reactivity", "aspect_scale":0.8 },
        "spawn_rate":            { "label":"Spawn Rate",            "type":"numeric","smooth":true,  "min":0,"max":60,      "aspect":"reactivity", "aspect_scale":1.0 },
        "beat_burst":            { "label":"Beat Burst",            "type":"integer","smooth":true,  "min":0,"max":12,      "aspect":"reactivity", "aspect_scale":0.6 },
        "spawn_audio":           { "label":"Audio Spawn",           "type":"numeric","smooth":true,  "min":0,"max":2,       "aspect":"reactivity", "aspect_scale":0.5 },
        "speed_audio":           { "label":"Audio Speed",           "type":"numeric","smooth":true,  "min":0,"max":2,       "aspect":"reactivity", "aspect_scale":0.5 },
        "impulse_decay":         { "label":"Impulse Decay",         "type":"numeric","smooth":true,  "min":0.01,"max":0.3 },
        "max_blobs":             { "label":"Max Blobs",             "type":"integer","smooth":true,  "min":20,"max":1024,   "aspect":"reactivity", "aspect_scale":0.4 },
        "edge_speed":            { "label":"Edge Speed",            "type":"numeric","smooth":true,  "min":0.05,"max":1.0 },
        "color_mode":            { "label":"Color Mode",            "type":"enum",   "smooth":false, "options":["wheel","band","random"] },
        "frequency_range":       { "label":"Audio Band",            "type":"enum",   "smooth":false, "options":["Beat","Bass","Lows (beat+bass)","Mids","High"] },
        "gradient":              { "label":"Gradient",              "type":"gradient","smooth":true,                        "aspect":"color" },
        "background_color":      { "label":"BG Color",              "type":"color",  "smooth":true,                        "aspect":"bg_color" },
        "background_brightness": { "label":"Background Brightness", "type":"numeric","smooth":true,  "min":0,"max":1,      "aspect":"brightness", "aspect_scale":1.0 },
        "brightness":            { "label":"Effect Brightness",     "type":"numeric","smooth":true,  "min":0,"max":1,      "aspect":"brightness", "aspect_scale":1.0 }
      },
      "defaults": {
        "swirl": 3.0, "reverse": true, "radius_scale": 1.0, "blob_size": 1.0,
        "trail_decay": 0.4, "base_speed": 1.0, "spawn_rate": 1.0, "beat_burst": 1,
        "spawn_audio": 1.0, "speed_audio": 1.0, "impulse_decay": 0.06,
        "max_blobs": 50, "edge_speed": 0.25,
        "color_mode": "wheel", "gradient_spin": 0.1,
        "horizon_scale": 0.25, "horizon_audio": 0.3, "horizon_color": "#ffffff",
        "frequency_range": "Lows (beat+bass)",
        "gradient": "linear-gradient(90deg, #ff0000 0.00%,#ff7800 14.00%,#ffc800 28.00%,#00ff00 42.00%,#00c78c 56.00%,#0000ff 70.00%,#800080 84.00%,#ff00b2 98.00%)",
        "background_color": "#000000", "background_brightness": 1.0, "brightness": 1.0
      }
    },
    "gifplayer": {
      "params": {
        "image_location": { "label":"Dance GIF", "type":"string",  "smooth":false, "options_source":"gif_assets", "resets_effect":true },
        "gif_fps":        { "label":"GIF FPS",   "type":"integer", "smooth":true,  "min":1,"max":60, "aspect":"reactivity" },
        "bounce":         { "label":"Ping Pong", "type":"toggle",  "smooth":false, "aspect":"shape" }
      },
      "defaults": {
        "image_location": "spotfx/dancer/dancer_basic.gif",
        "gif_fps":        10
      }
    }
  }
}
