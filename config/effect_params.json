        "brightness_audio":      { "label":"Brightness Audio",      "type":"numeric","smooth":true,  "min":0,"max":2,       "aspect":"reactivity", "distribute":false },
        "size_audio":            { "label":"Size Audio",            "type":"numeric","smooth":true,  "min":0,"max":2,       "aspect":"reactivity", "distribute":false },
        "trail_decay":           { "label":"Trail Length",          "type":"numeric","smooth":true,  "min":0,"max":1,       "aspect":"shape" },
        "gradient_spin":         { "label":"Gradient Spin",         "type":"numeric","smooth":true,  "min":-1,"max":1,      "flip_sign":true, "aspect":"shape" },
